<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transport Cost Calculator"
            android:textColor="@color/navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Estimate your delivery and transport expenses."
            android:textColor="@color/grey_text"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Trip Details"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Distance (km)"
                    android:textColorHint="@color/indigo"
                    android:background="@color/blue_light"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etFuelConsumption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Fuel consumption (L/100 km)"
                    android:textColorHint="@color/indigo"
                    android:background="@color/blue_light"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etFuelPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Fuel price (R per litre)"
                    android:textColorHint="@color/indigo"
                    android:background="@color/blue_light"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="Additional Expenses"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTollFees"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Toll fees (R)"
                    android:inputType="numberDecimal"
                    android:background="@color/blue_light"
                    android:singleLine="true"
                    android:text="0"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etDriverWages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Driver wages (R)"
                    android:background="@color/blue_light"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:text="0"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/etOtherExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Other expenses (R)"
                    android:background="@color/blue_light"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:text="0"
                    android:padding="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Calculate Cost"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/navy"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Clear Fields"
                    android:textColor="@color/navy"
                    app:strokeColor="@color/navy" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/navy"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cost Summary"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Fuel Cost"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFuelCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R 0.00"
                    android:textColor="@color/gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Total Trip Cost"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R 0.00"
                    android:textColor="@color/gold"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cost Per Kilometre"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCostPerKm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="R 0.00 / km"
                    android:textColor="@color/gold"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
