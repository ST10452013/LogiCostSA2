<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme only: the layouts use fixed light colours. -->
    <style name="Theme.LogiCostApp3" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/navy_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.LogiCost.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.LogiCost.Medium</item>
        <item name="materialButtonStyle">@style/Widget.LogiCost.Button</item>
        <item name="materialCardViewStyle">@style/Widget.LogiCost.Card</item>
        <item name="textInputStyle">@style/Widget.LogiCost.TextInput</item>
    </style>

    <style name="Shape.LogiCost.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.LogiCost.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.LogiCost.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.LogiCost.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/light_grey</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LogiCost.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/navy</item>
        <item name="hintTextColor">@color/navy</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="TextAppearance.LogiCost.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Section headings used across screens -->
    <style name="TextAppearance.LogiCost.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
